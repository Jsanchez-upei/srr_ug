library(glossary)
library(DT)
# Read glossary terms from the YAML file
terms <- read_yaml_glossary("terms.yaml")
# Convert to a searchable DT table
datatable(render_glossary(terms),
caption = "Glossary of Terms",
options = list(pageLength = 10, autoWidth = TRUE))
