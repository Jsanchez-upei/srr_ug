# Read glossary terms from the YAML file
terms <- yaml::read_yaml("terms.yaml")
library(yaml)
library(DT)
# Load YAML
yaml_data <- yaml::read_yaml("terms.yaml")
# Convert to data frame
glossary_df <- data.frame(
Term = sapply(yaml_data, function(x) x$term),
Definition = sapply(yaml_data, function(x) x$definition)
)
# Display searchable glossary
datatable(glossary_df,
caption = "Glossary of Terms",
options = list(pageLength = 10, autoWidth = TRUE))
# Load YAML
yaml_data <- yaml::read_yaml("terms.yaml")
# Convert to data frame
glossary_df <- data.frame(
Term = sapply(yaml_data, function(x) x$term),
Definition = sapply(yaml_data, function(x) x$definition)
)
# Display searchable glossary
datatable(glossary_df,
caption = "Glossary of Terms",
options = list(pageLength = 10, autoWidth = TRUE))
library(yaml)
library(DT)
# Load YAML
yaml_data <- yaml::read_yaml("terms.yaml")
# In your .qmd document
yaml_data <- yaml::read_yaml("terms.yaml")
# Add anchor tags for linking
glossary_df <- data.frame(
Term = sapply(yaml_data, function(x)
paste0('<a name="', tolower(gsub("[^a-zA-Z0-9]", "-", x$term)), '">', x$term, '</a>')),
Definition = sapply(yaml_data, function(x) x$definition),
stringsAsFactors = FALSE
)
DT::datatable(glossary_df, escape = FALSE)
