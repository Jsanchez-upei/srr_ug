library(glossary)
library(yaml)
library(DT)
# Read glossary terms from the YAML file
terms <- read_yaml("terms.yaml")
# Convert it to a data frame
glossary_df <- data.frame(
Term = sapply(terms, `[[`, "term"),
Definition = sapply(terms, `[[`, "definition")
)
# Render a searchable table
datatable(glossary_df,
caption = "Glossary of Terms",
options = list(pageLength = 10, autoWidth = TRUE))
